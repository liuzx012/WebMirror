{
  "manifest_version": 3,
  "name": "WebMirror",
  "version": "1.0",
  "description": "网站镜像工具 - 递归爬取资源，捕获网络请求与网页源码，打包ZIP离线托管",
  "author": "Security Research",
  "permissions": [
    "tabs",
    "downloads",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
